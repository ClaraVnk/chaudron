# syntax pinned by digest-free tags on purpose: bump deliberately, never implicitly.
#
# Build with Podman from the repository root:
#   podman build -t localhost/chaudron-api:dev -f backend/Containerfile backend
#
# NOTE: HEALTHCHECK is a Docker-format instruction. Podman's default OCI output
# format drops it with a warning, so build with `--format docker` when the
# baked-in healthcheck matters. Quadlet deployments declare their own
# HealthCmd= instead, which works regardless of image format.

# ---------------------------------------------------------------------------
# Stage 1 — build: resolve and install dependencies into a self-contained venv.
# ---------------------------------------------------------------------------
FROM ghcr.io/astral-sh/uv:python3.14-bookworm-slim AS builder

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    UV_NO_DEV=1

# The venv is built at the path it will be used from, and that is not cosmetic.
# A console script installed by pip/uv carries an absolute shebang: building in
# /build produced `#!/build/.venv/bin/python` in every entry point, a path that
# does not exist in the runtime stage. The image then failed to start at all —
# `sh: exec: uvicorn: not found`, because the interpreter behind the shebang is
# what is missing, not the script — and `alembic` was equally unusable. Keep
# this WORKDIR identical to the runtime WORKDIR.
WORKDIR /app

# Dependency manifests first: this layer is cached until the lockfile changes.
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-install-project --no-dev

# Application source, then install the project itself into the same venv.
COPY src ./src
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-editable --no-dev

# ---------------------------------------------------------------------------
# Stage 2 — runtime: minimal image, no build toolchain, no uv, non-root.
# ---------------------------------------------------------------------------
FROM python:3.14-slim-bookworm AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    CHAUDRON_PORT=8000

# Unprivileged account. A fixed UID/GID keeps rootless volume ownership stable
# across rebuilds and across the host's subuid range.
RUN groupadd --system --gid 10001 chaudron \
    && useradd --system --uid 10001 --gid chaudron --home-dir /app --no-create-home chaudron

WORKDIR /app

# Owned by root, not by the account that runs the code. The application only
# ever needs to read its own interpreter and libraries, so making them writable
# by `chaudron` bought nothing and handed any code-execution bug a place to
# persist: a rewritten module, or a poisoned `__pycache__/*.pyc` that CPython
# accepts as valid while `git status` stays clean. `ReadOnly=true` in the
# quadlet closes the same door, but only for deployments that remember to set
# it — this closes it in the image itself.
COPY --from=builder --chown=root:root /app/.venv /app/.venv

# Alembic configuration and revision scripts. `chaudron-migrate.container` runs
# `alembic upgrade head` from this image with WORKDIR=/app; without these two
# lines that unit fails with "No config file 'alembic.ini' found", which is to
# say the documented deployment path for a release carrying a migration did not
# work. Root-owned and read-only to the application, like everything else here.
COPY --chown=root:root alembic.ini /app/
COPY --chown=root:root migrations /app/migrations

# Any __pycache__ the build context happened to carry is stale by definition and
# has no business in a release artefact.
RUN find /app/migrations -name '__pycache__' -type d -prune -exec rm -rf {} +

USER chaudron

EXPOSE 8000

# Liveness only: /healthz answers without touching the database, so a degraded
# dependency does not get the container killed. Readiness (/readyz) is checked
# by the orchestrator, not here.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["python", "-c", "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen(f\"http://127.0.0.1:{os.environ.get('CHAUDRON_PORT','8000')}/healthz\", timeout=4).status == 200 else 1)"]

CMD ["sh", "-c", "exec uvicorn chaudron.api.main:app --host 0.0.0.0 --port \"${CHAUDRON_PORT:-8000}\""]
