# Chaudron — configuration template.
# Copy to `.env` and fill in real values. `.env` is gitignored; never commit secrets.
# Every key below is read at startup and validated (fail-fast on missing/invalid values).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Deployment environment: local | staging | production
CHAUDRON_ENV=
# Log level: DEBUG | INFO | WARNING | ERROR
CHAUDRON_LOG_LEVEL=
# Port the ASGI server binds to inside the container
CHAUDRON_PORT=
# Public base URL of the API, used to build absolute links
CHAUDRON_BASE_URL=

# ---------------------------------------------------------------------------
# Database (PostgreSQL 16, async driver)
# ---------------------------------------------------------------------------
# Full async DSN: postgresql+asyncpg://user:password@host:5432/dbname
#
# IMPORTANT — this must name the application role, not the role that owns the
# tables. PostgreSQL exempts a table's owner from its own row-level security
# policies, so an API connecting as the owner enforces nothing between
# households while every endpoint keeps answering normally. See ops/README.md
# section 6 and `backend/scripts/provision_app_role.py`.
CHAUDRON_DATABASE_URL=
# SQLAlchemy connection pool size
CHAUDRON_DB_POOL_SIZE=
# Extra connections allowed above the pool size
CHAUDRON_DB_MAX_OVERFLOW=

# ---------------------------------------------------------------------------
# Row-level security — provisioning only
# ---------------------------------------------------------------------------
# Read by `backend/scripts/provision_app_role.py`, never by the API. Run that
# script with CHAUDRON_DATABASE_URL pointing at the OWNER, then put the app
# role's own DSN in CHAUDRON_DATABASE_URL above and keep the owner DSN for
# `alembic upgrade` only.
#
# Name of the non-owner role the application connects as (default: chaudron_app)
CHAUDRON_DB_APP_ROLE=
# Its password. Supply it for the length of one command and unset it after:
#   read -rs -p 'App role password: ' CHAUDRON_DB_APP_PASSWORD && export CHAUDRON_DB_APP_PASSWORD
#   uv run python scripts/provision_app_role.py && unset CHAUDRON_DB_APP_PASSWORD
# Leave empty here: this file is a template, not a vault.
CHAUDRON_DB_APP_PASSWORD=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Random 32+ byte secret used to sign sessions and JWTs (generate: openssl rand -hex 32)
CHAUDRON_SECRET_KEY=
# Access token lifetime, in minutes
CHAUDRON_JWT_TTL_MINUTES=
# JWT signing algorithm, e.g. HS256
CHAUDRON_JWT_ALGORITHM=

# ---------------------------------------------------------------------------
# Household credential encryption — REQUIRED
# ---------------------------------------------------------------------------
# Households store their own provider API keys. Those are encrypted at rest with
# this key, which must never live in the database: a stolen dump must not be
# enough to decrypt third-party secrets. Generate: openssl rand -base64 32
# Rotating this value invalidates every stored household credential.
CHAUDRON_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# `instance_owner` mode — the operator's OWN keys, for the operator's OWN household
# ---------------------------------------------------------------------------
# Chaudron never funds inference for its users. The keys below are usable only by
# the household named here; every other household must bring its own (`byok`) or
# point at an Ollama instance. Leave empty to disable the mode entirely.
CHAUDRON_INSTANCE_OWNER_HOUSEHOLD_ID=

# Fill in only the providers you actually use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Model used for documentation, examples and the `instance_owner` mode
CHAUDRON_LLM_DEFAULT_MODEL=claude-opus-5
# Max output tokens per request
CHAUDRON_LLM_MAX_TOKENS=
# Ceiling on spend per calendar month, in USD. Only meaningful for
# `instance_owner` mode — in `byok` the household is billed by its own provider,
# and in `ollama` nothing is billed at all.
CHAUDRON_LLM_MONTHLY_BUDGET_USD=
# Timeout for a single provider call, in seconds
CHAUDRON_LLM_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Ollama — local inference (server-side, colocated only)
# ---------------------------------------------------------------------------
# Households supply their own Ollama base URL, and the server calls it: that is
# an SSRF primitive. Blocking private ranges does not work here, because a
# legitimate colocated Ollama address IS private. An explicit host allowlist is
# therefore the control. Comma-separated `host:port` endpoints, typically the
# Podman service name of the Ollama container: `ollama:11434`. The port is part
# of the control -- without it a household could dial every *other* port of an
# allowed host and tell open ones from closed ones, which is a port scanner. A
# bare `host` is accepted and means port 11434 only, never "any port".
# IPv6 literals are written bracketed: `[::1]:11434`. Empty disables `ollama`.
CHAUDRON_OLLAMA_ALLOWED_HOSTS=
# Timeout for a single Ollama call, in seconds — local models can be slow
CHAUDRON_OLLAMA_TIMEOUT_SECONDS=

# ---------------------------------------------------------------------------
# Open Food Facts — product lookup by barcode
# ---------------------------------------------------------------------------
# Required by their API policy: "AppName/version (contact-email)"
CHAUDRON_OFF_USER_AGENT=
# Base URL of the Open Food Facts API
CHAUDRON_OFF_BASE_URL=https://world.openfoodfacts.org
# Cache lifetime for product lookups, in seconds
CHAUDRON_OFF_CACHE_TTL_SECONDS=

# ---------------------------------------------------------------------------
# Inbound email — receipts forwarded for OCR
# ---------------------------------------------------------------------------
# Shared secret validating the inbound-email webhook signature
CHAUDRON_INBOUND_EMAIL_WEBHOOK_KEY=
# Domain that receives forwarded receipts, e.g. receipts.example.org
CHAUDRON_INBOUND_EMAIL_DOMAIN=
# Max accepted attachment size, in bytes
CHAUDRON_INBOUND_EMAIL_MAX_BYTES=

# ---------------------------------------------------------------------------
# Abuse and availability limits
# ---------------------------------------------------------------------------
# These are counted PER PROCESS, in memory. Two uvicorn workers grant two
# budgets, and a restart forgets every counter. That is accepted for this slice
# and documented in backend/src/chaudron/api/throttling.py; moving past one
# worker requires moving the counters to PostgreSQL first.

# Max accepted request body, in bytes. Default 262144 (256 KiB) — a hundredfold
# margin over the largest legitimate v1 request. Deliberately NOT sized for the
# receipt photo import: that route needs the order of magnitude of
# CHAUDRON_INBOUND_EMAIL_MAX_BYTES below (10 MiB) and must carry its own,
# higher, per-route bound rather than raising this one for every endpoint.
CHAUDRON_MAX_REQUEST_BODY_BYTES=
# Recipe suggestions per household per hour. Each one is a billed model call.
CHAUDRON_RECIPE_SUGGESTIONS_PER_HOUR=
# Recipe suggestions in flight at once, per household — two open tabs must not
# double the bill.
CHAUDRON_RECIPE_MAX_CONCURRENT_PER_HOUSEHOLD=
# Recipe suggestions in flight at once, for the whole process. Lower it to 1 or 2
# when inference runs on a colocated Ollama on a small machine (ADR-0007).
CHAUDRON_RECIPE_MAX_CONCURRENT_TOTAL=
# Barcode lookups per household per minute. Must stay BELOW the ten calls a
# minute that Open Food Facts allows this whole instance, or one household can
# still drain the shared budget on its own (ADR-0008).
CHAUDRON_PRODUCT_LOOKUPS_PER_MINUTE=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins, e.g. https://chaudron.example.org
# '*' is refused at startup: this API is authorised by the X-Household-Id header
# rather than by cookies, so a wildcard origin would let any site on the internet
# read a household's data.
CHAUDRON_CORS_ORIGINS=
# Allow cookies/Authorization headers on cross-origin requests: true | false
CHAUDRON_CORS_ALLOW_CREDENTIALS=

# ---------------------------------------------------------------------------
# API documentation
# ---------------------------------------------------------------------------
# Serve /docs and /openapi.json: true | false. Empty means "only when
# CHAUDRON_ENV is local" — a forgotten variable must close the documentation,
# not open it.
CHAUDRON_ENABLE_DOCS=
