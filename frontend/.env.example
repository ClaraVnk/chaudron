# Chaudron PWA — build-time configuration.
#
# Copy to `.env.local` and fill in. Every VITE_* value is INLINED INTO THE
# JAVASCRIPT BUNDLE at build time and is therefore public. Never put a secret,
# an API key or a provider token here.

# Base URL of the Chaudron API, without a trailing slash and without `/v1`
# (the client appends `/v1/...` itself).
# Dev against a local backend:
VITE_API_BASE_URL=http://localhost:8000

# Household identifier sent as `X-Household-Id` on every call.
#
# Slice-1 mechanism only: the API contract documents this header as provisional,
# standing in for a real session. It is an addressing value, not a credential —
# but it is still visible in the bundle, so a deployment open to the internet
# must not rely on it for access control. Seeded by the backend's demo fixture.
VITE_HOUSEHOLD_ID=00000000-0000-0000-0000-000000000000
